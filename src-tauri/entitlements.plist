<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required: microphone access for voice recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- com.apple.security.inherit lets this app act as a sandbox-inheriting helper
         when launched BY another sandboxed parent (e.g. via NSWorkspace/XPC); it has
         no effect on how this app's own children are treated. It does NOT make the
         voice-typer sidecar inherit this app's TCC grants: the sidecar is spawned as
         a plain child process (not launched through an inheriting-sandbox API) and is
         signed under its own distinct code identity, so macOS TCC tracks it separately
         and requires its own grants for microphone/Accessibility/Input Monitoring —
         see check_sidecar_permissions()/run_sidecar_permission_preflight() in main.rs.
         This entitlement is kept for compatibility/potential future embedding
         scenarios; it is not load-bearing for the sidecar permission story. -->
    <key>com.apple.security.inherit</key>
    <true/>

    <!-- Required: whisper.cpp and some Rust runtime code requires JIT/unsigned
         executable memory (e.g. GGML backends) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required: voice-typer sidecar is signed separately by rustc; without this
         the parent app cannot load it under library validation -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
